<?xml version="1.0"?>
<package format="3">
    <name>flexbe_river_crossing_visualization</name>
    <version>0.0.2</version>
    <description>
        Pygame-based visualization node for the FlexBE river-crossing synthesis
        demonstration. Subscribes to /wgcf_status and renders characters, boats,
        and banks for the wolf-goat-corn-farmer puzzle.
    </description>
    <maintainer email="robotics@cnu.edu">David Conner</maintainer>
    <license>Apache-2.0</license>

    <url type="website">https://github.com/CNURobotics/flexbe_synthesis_demo</url>
    <url type="bugtracker">https://github.com/CNURobotics/flexbe_synthesis_demo/issues</url>
    <url type="repository">https://github.com/CNURobotics/flexbe_synthesis_demo</url>

    <author>Joshua Luzier</author>
    <author>William Doyle</author>
    <author email="robotics@cnu.edu">David Conner</author>

    <depend>rclpy</depend>
    <exec_depend>ament_index_python</exec_depend>
    <depend>flexbe_river_crossing_msgs</depend>
    <depend>python3-pygame</depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
