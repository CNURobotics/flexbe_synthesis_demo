<?xml version="1.0"?>
<package format="3">
    <name>pyrobosim_flexbe_behaviors</name>
    <version>0.0.2</version>
    <description>
       All implemented FlexBE behaviors for ROSCon '24
       Deliberative Technologies Workshop.
    </description>
    <author email="robotics@cnu.edu">David Conner</author>
    <maintainer email="robotics@cnu.edu">David Conner</maintainer>
    <license>BSD-3-Clause</license>
    <license>Apache-2.0</license>

    <exec_depend>rclpy</exec_depend>
    <exec_depend>flexbe_behavior_engine</exec_depend>
    <exec_depend>flexbe_states</exec_depend>
    <exec_depend>flexbe_webui</exec_depend>
    <exec_depend>pyrobosim_flexbe_states</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_cmake_pytest</test_depend>
    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>ament_cmake_python</buildtool_depend>

    <export>
