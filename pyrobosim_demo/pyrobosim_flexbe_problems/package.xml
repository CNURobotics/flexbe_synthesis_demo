<?xml version="1.0"?>
<package format="3">
    <name>pyrobosim_flexbe_problems</name>
    <version>0.0.1</version>
    <description>
      Example worlds for the FlexBE PyRoboSim demonstrations based on ROSCon '24 ROS 2 Deliberation Workshop.
    </description>
    <author email="robotics@cnu.edu">David Conner</author>
    <maintainer email="robotics@cnu.edu">David Conner</maintainer>
    <license>BSD-3-Clause</license>
    <license>Apache-2.0</license>

    <exec_depend>rclpy</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>flexbe_core</exec_depend>
    <exec_depend>pyrobosim_msgs</exec_depend>
    <exec_depend>pyrobosim_ros</exec_depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>

</package>
