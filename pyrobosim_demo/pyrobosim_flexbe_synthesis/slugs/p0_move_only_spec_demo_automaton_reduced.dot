digraph StateMachine {
  outputorder="edgesfirst";
  layout="dot";
  splines=true;
  rankdir=LR;
  nodesep=0.8;
  ranksep=1.2;
  overlap=false;
  dpi=150;
  fontname="Liberation Sans";
  node [fontname="Liberation Sans", fontweight="bold", penwidth=2.0];
  edge [fontname="Liberation Sans", fontweight="bold", penwidth=2.0];
  "Init" [shape=point];
  "0" [width=0.4, height=0.4, fontsize=6, xlabel="0
log_move_failed_c
robot_loc=18"];
  "0_sys" [width=0.1, height=0.1, style=filled, fillcolor=black, fontsize=6, xlabel="0_sys
move_robot_a
move_dest=3", label=""];
  "1" [width=0.4, height=0.4, fontsize=6, xlabel="1
move_robot_f
robot_loc=18"];
  "1_sys" [width=0.1, height=0.1, style=filled, fillcolor=black, fontsize=6, xlabel="1_sys
log_move_failed_a
move_dest=1", label=""];
  "2" [width=0.4, height=0.4, fontsize=6, xlabel="2
move_robot_c
robot_loc=3"];
  "2_sys" [width=0.1, height=0.1, style=filled, fillcolor=black, fontsize=6, xlabel="2_sys
finished
move_dest=1", label=""];
  "Init" -> "0";
  "0" -> "0_sys" [color="green"];
  "0_sys" -> "1" [color="red"];
  "0_sys" -> "2" [color="red"];
  "1" -> "1_sys" [color="green"];
  "1_sys" -> "0" [color="red"];
  "2" -> "2_sys" [color="green"];
  "2_sys" -> "2" [color="red"];
}