<?xml version="1.0"?>
<package format="3">
  <name>pyrobosim_flexbe_synthesis</name>
  <version>0.0.2</version>
  <description>
    FlexBE synthesis pipeline configuration for PyRoboSim HFSM demonstrations
    using LTL-based slugs synthesizer.
  </description>
  <author email="robotics@cnu.edu">David Conner</author>
  <maintainer email="robotics@cnu.edu">David Conner</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>

  <!-- FlexBE runtime -->
  <exec_depend>flexbe_behavior_engine</exec_depend>
  <exec_depend>flexbe_webui</exec_depend>

  <!-- synthesis pipeline -->
  <exec_depend>flexbe_synthesis_core</exec_depend>
  <exec_depend>flexbe_synthesis_generic</exec_depend>
  <exec_depend>flexbe_synthesis_msgs</exec_depend>
  <exec_depend>flexbe_synthesis_slugs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Synthesis demo sibling packages -->
  <exec_depend>pyrobosim_flexbe_behaviors</exec_depend>
  <exec_depend>pyrobosim_flexbe_problems</exec_depend>
  <exec_depend>pyrobosim_flexbe_states</exec_depend>
  <exec_depend>pyrobosim_flexbe_utilities</exec_depend>

  <!-- testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
